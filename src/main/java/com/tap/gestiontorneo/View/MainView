package com.tap.gestiontorneo.view;

import javafx.geometry.Insets;
import javafx.geometry.Pos;
import javafx.scene.Scene;
import javafx.scene.control.Button;
import javafx.scene.control.Label;
import javafx.scene.layout.*;
import javafx.stage.Stage;
import org.kordamp.bootstrapfx.BootstrapFX;

public class MainView {

    private BorderPane rootLayout;

    private Pane cuentaView;
    private Pane equiposView;
    private Pane tablaView;
    private Pane calendarioView;

    public void start(Stage stage) {

        rootLayout = new BorderPane();

        cuentaView = new CuentaView();
        equiposView = new EquiposView();
        tablaView = new TablaView();
        calendarioView = new CalendarioView();

        VBox menu = buildSideMenu();

        rootLayout.setLeft(menu);
        rootLayout.setCenter(cuentaView);

        Scene scene = new Scene(rootLayout, 1000, 600);
        scene.getStylesheets().add(BootstrapFX.bootstrapFXStylesheet());

        stage.setScene(scene);
        stage.setTitle("Panel Principal");
        stage.show();
    }

    private VBox buildSideMenu() {

        Label title = new Label("Menú");
        title.getStyleClass().addAll("h3", "text-primary");

        Button b1 = new Button("Cuenta");
        Button b2 = new Button("Equipos");
        Button b3 = new Button("Tabla");
        Button b4 = new Button("Calendario");

        for (Button b : new Button[]{b1, b2, b3, b4})
            b.getStyleClass().addAll("btn", "btn-outline-primary", "btn-lg", "m-1");

        b1.setOnAction(e -> rootLayout.setCenter(cuentaView));
        b2.setOnAction(e -> rootLayout.setCenter(equiposView));
        b3.setOnAction(e -> rootLayout.setCenter(tablaView));
        b4.setOnAction(e -> rootLayout.setCenter(calendarioView));

        VBox v = new VBox(12, title, b1, b2, b3, b4);
        v.setPadding(new Insets(20));
        v.setAlignment(Pos.TOP_CENTER);
        v.setPrefWidth(220);

        return v;
    }
}


